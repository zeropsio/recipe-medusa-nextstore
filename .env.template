# Medusa backend. NEXT_PUBLIC_* is baked into the Next.js bundle at build time.
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from Medusa Admin → Settings → API Key Management
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=de

# Optional Stripe checkout
NEXT_PUBLIC_STRIPE_KEY=

# Optional on-demand revalidation
REVALIDATE_SECRET=supersecret

# Zerops MinIO (used by next.config.js image remotePatterns)
OBJECT_STORAGE_API_URL=

# Optional Meilisearch (the DTC starter does not ship InstantSearch UI)
NEXT_PUBLIC_FEATURE_SEARCH_ENABLED=false
NEXT_PUBLIC_SEARCH_ENDPOINT=
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_INDEX_NAME=products
